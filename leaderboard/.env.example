# ---------------------------------------------------------------------------
# CAC ABAC Workshop Leaderboard — Environment Variables
# Copy this file to .env and fill in the values before running docker compose
# .env is git-ignored — never commit real credentials
# ---------------------------------------------------------------------------

# SAP RFC connection (used for automatic SAP user creation on registration)
SAP_HOST=10.8.0.1
SAP_SYSNR=00
SAP_CLIENT=001
SAP_USER=DEVELOPER
SAP_PASSWORD=

# SAP role assigned to every workshop participant (must exist in the system)
# Create this role in PFCG before the session and assign relevant auth objects
SAP_WORKSHOP_ROLE=Z_DAC_WORKSHOP_PARTICIPANT

# WireGuard peer auto-creation (called via SSH to the host)
# SSH key is mounted into the container at /secrets/wg_ssh_key (see docker-compose.yml)
WG_HOST=127.0.0.1
WG_SSH_USER=root
WG_SSH_KEY_PATH=/secrets/wg_ssh_key
WG_PEERS_DIR=/wg-peers
WG_ADD_PEER_CMD=/etc/wireguard/add-peer.sh

# Leaderboard port (default 9000)
# PORT=9000
