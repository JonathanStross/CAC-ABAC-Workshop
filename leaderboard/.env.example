# ---------------------------------------------------------------------------
# CAC ABAC Workshop Leaderboard — Environment Variables
# Copy this file to .env and fill in the values before running docker compose
# .env is git-ignored — never commit real credentials
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Access code that participants must enter before seeing the registration form.
# Announce this at the start of the session (e.g. on a slide).
# Leave empty to disable the gate (not recommended on public servers).
REGISTER_CODE=meridian2026

# Flask session secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be set to a stable value so sessions survive container restarts.
SECRET_KEY=

# HTTP Basic Auth password for /admin and /admin/reset
# Username is always "admin"
# Leave empty to rely on VPN-only access instead
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SAP — default RFC connection
# SAP_HOST is the WireGuard VPN address shown to participants (always 10.8.0.1).
# SAP2_HOST is the backend host used for actual RFC calls.
# sap3/4/5 were decommissioned July 2026.
# ---------------------------------------------------------------------------
SAP_HOST=10.8.0.1
SAP_SYSNR=00
SAP_CLIENT=001
SAP_USER=DEVELOPER
SAP_PASSWORD=

# SAP role assigned to every workshop participant (must exist in the system)
SAP_WORKSHOP_ROLE=Z_DAC_WORKSHOP_PARTICIPANT

# ---------------------------------------------------------------------------
# SAP server — sap2 only
# ---------------------------------------------------------------------------
SAP2_HOST=159.195.81.132

# SSH key path INSIDE the container (mapped via docker-compose volumes).
SAP2_WG_KEY=/secrets/wg_sap2_key

# ---------------------------------------------------------------------------
# WireGuard — shared settings (applied to all servers)
# ---------------------------------------------------------------------------
WG_SSH_USER=root
WG_ADD_PEER_CMD=/etc/wireguard/add-peer.sh
WG_REMOVE_PEER_CMD=/etc/wireguard/remove-peer.sh

# Legacy single-server settings (offgrid fallback — not used in multi-server mode)
WG_HOST=127.0.0.1
WG_SSH_KEY_PATH=/secrets/wg_ssh_key
WG_PEERS_DIR=/wg-peers

# Leaderboard port (default 9000)
# PORT=9000
